# =============================================================================
# WRINDHAOS ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# =============================================================================

# 1. SERVER CONFIGURATION
NODE_ENV=production
PORT=8080

# 2. SUPABASE CLOUD DATABASE CONFIGURATION
# Grab these from your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres

# 3. JWT AUTHENTICATION SECURITY
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=30d

# 4. VERIFIED EMAIL SENDER & OTP DISPATCHER
EMAIL_PROVIDER=msg91
EMAIL_FROM_ADDRESS=noreply@wrindhaos.in
EMAIL_FROM_NAME=WrindhaOS
EMAIL_DOMAIN=wrindhaos.in
EMAIL_SENDER=noreply@wrindhaos.in

# MSG91 Live OTP Credentials
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_WIDGET_ID=your_msg91_widget_id
MSG91_OTP_TEMPLATE_ID=your_otp_template_id
