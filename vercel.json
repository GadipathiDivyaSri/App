    {
      "source": "/api/auth/forgot-password/verify-otp",
      "destination": "/api/auth-forgot-password-verify-otp"
    },
    {
      "source": "/api/auth/forgot-password/reset",
      "destination": "/api/auth-forgot-password-reset"
    },
    {
      "source": "/api/users/me",
      "destination": "/api/users-me"
