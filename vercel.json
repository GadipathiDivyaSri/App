      "destination": "/api/health"
    },
    {
      "source": "/api/subscription/me",
      "destination": "/api/subscription-me"
    },
    {
      "source": "/api/subscription/upgrade",
      "destination": "/api/subscription-upgrade"
    },
    {
      "source": "/api/subscription-me",
      "destination": "/api/subscription-me"
    },
    {
      "source": "/api/subscription-upgrade",
      "destination": "/api/subscription-upgrade"
    },
    {
      "source": "/api/subscription",
      "destination": "/api/subscription"
    },
    {
      "source": "/api/tasks/:path*",
      "destination": "/api/tasks?id=:path*"
