    {
      "source": "/api/tasks",
      "destination": "/api/tasks"
    },
    {
      "source": "/api/auth/login-initiate",
      "destination": "/api/auth-login-initiate"
    },
    {
      "source": "/api/auth/login-verify",
      "destination": "/api/auth-login-verify"
    },
    {
      "source": "/api/auth/login",
      "destination": "/api/auth-login"
    },
    {
      "source": "/api/auth/refresh-token",
      "destination": "/api/auth-refresh-token"
    },
    {
      "source": "/api/auth/register-initiate",
      "destination": "/api/auth-register-initiate"
    },
    {
      "source": "/api/auth/register-verify",
      "destination": "/api/auth-register-verify"
    },
    {
      "source": "/api/auth/forgot-password/initiate",
      "destination": "/api/auth-forgot-password-initiate"
