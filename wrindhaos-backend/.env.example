# WrindhaOS Production Backend Environment Configuration

PORT=5000
NODE_ENV=production

# Supabase PostgreSQL Configuration
SUPABASE_URL=https://xyzproductivedb.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_key

# JWT Secret Token Key
JWT_SECRET=wrindhaos_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=30d

# Google OAuth Authentication
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Google Play Developer API (Server-Side Subscription Verification Only)
GOOGLE_PLAY_PACKAGE_NAME=com.wrindhaos.app
GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=wrindhaos-billing@your-project-id.iam.gserviceaccount.com
GOOGLE_PLAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
GOOGLE_PLAY_SUBSCRIPTION_PRODUCT_ID=wrindhaos_premium_monthly

# Mobile SMS OTP Service Provider (Pluggable Provider Architecture)
OTP_PROVIDER=twilio
OTP_API_KEY=your_otp_provider_api_key
OTP_TEMPLATE_ID=your_otp_sms_template_id

# Firebase Cloud Messaging (FCM) Push Notifications
FCM_PROJECT_ID=wrindhaos-firebase-project
FCM_CLIENT_EMAIL=firebase-adminsdk@wrindhaos-firebase-project.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Web Client URL
FRONTEND_URL=http://localhost:8080
